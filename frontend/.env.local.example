# ============================================================
# JOMISH CASINO — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# ---- SUPABASE ----
# Get these from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- SLOTSLAUNCH (FREE Casino Games API) ----
# Register FREE at: https://slotslaunch.com
# Then go to: Launch Pad → API → register your domain → copy API Key
# This gives you access to 5,000+ real casino game iframes (Slots, Table, Live, etc.)
SLOTSLAUNCH_API_KEY=your-slotslaunch-api-key-here

# ---- THE ODDS API (FREE Sports Betting) ----
# Register FREE at: https://the-odds-api.com
# Free tier includes 500 API calls/month — enough for dev and light production use
ODDS_API_KEY=your-odds-api-key-here

# ---- DUSUPAY (Uganda Payments — MTN/Airtel/Card) ----
# Register at: https://dusupay.com for sandbox access
# Sandbox is completely free, no charges for testing
DUSUPAY_API_KEY=your-dusupay-api-key-here
DUSUPAY_MERCHANT_ID=your-merchant-id-here
DUSUPAY_ENVIRONMENT=sandbox   # change to "production" when you go live
